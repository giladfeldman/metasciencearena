    given-names: Gilad
    affiliation: "University of Innsbruck"
repository-code: "https://github.com/giladfeldman/metasciencearena"
url: "https://metasciencearena.app"
license: MIT
version: 0.3.0
date-released: "2026-08-07"
keywords:
